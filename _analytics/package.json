{
  "name": "spear-analytics-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Spear Analytics web app (analytics.rumh.co). Its own build; the main site never reads this folder.",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "dev": "node scripts/tokens.mjs && vite",
    "build": "node scripts/tokens.mjs && tsc --noEmit && vite build && node scripts/headers.mjs",
    "preview": "vite preview",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
